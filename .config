CONFIG_TARGET_mvebu=y
CONFIG_TARGET_mvebu_cortexa9=y
CONFIG_TARGET_mvebu_cortexa9_DEVICE_linksys_wrt1900acs=y


#
# LuCI
#

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-mod-admin-full=y

CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-system=y
CONFIG_PACKAGE_luci-app-network=y
CONFIG_PACKAGE_luci-app-mountd=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-backup=y
CONFIG_PACKAGE_luci-app-upgrade=y
CONFIG_PACKAGE_luci-app-ledconfig=y
CONFIG_PACKAGE_luci-app-terminal=y

#
# Remove unnecessary status / diagnostics
#

CONFIG_PACKAGE_luci-mod-status=n
CONFIG_PACKAGE_luci-app-diag-core=n

#
# Linksys
#

CONFIG_PACKAGE_linksys-reboot=y


#
# WiFi disabled
#

CONFIG_PACKAGE_kmod-ath10k=n
CONFIG_PACKAGE_wpad-basic=n
CONFIG_PACKAGE_wireless-tools=n
CONFIG_PACKAGE_luci-app-wireless=n


#
# IPv6 disabled
#

CONFIG_PACKAGE_ipv6-support=n
CONFIG_PACKAGE_kmod-ipv6=n
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_PACKAGE_dnsmasq-ipv6=n


#
# PPP / PPPoE disabled
#

CONFIG_PACKAGE_ppp=n
CONFIG_PACKAGE_pppoe-discovery=n


#
# USB / U-Disk
#

CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_usbutils=y

#
# Keep both ext4 and F2FS filesystem tools
#

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_e2fsprogs-mke2fs=y
CONFIG_PACKAGE_f2fs-tools=y

CONFIG_PACKAGE_mountd=y


#
# mDNS / cross-subnet discovery
#

CONFIG_PACKAGE_avahi-daemon=y
CONFIG_PACKAGE_luci-app-avahi=y


#
# Network / diagnostic tools
#

CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_tcpdump=y


#
# Proxy completely disabled
#

CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_xray-core=n
CONFIG_PACKAGE_shadowsocks-libev=n


#
# Super Audio Bridge
# Python 3 + aiohttp + yaml
#

CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-aiohttp=y
CONFIG_PACKAGE_python3-yaml=y
