CONFIG_TARGET_mvebu=y
CONFIG_TARGET_mvebu_cortexa9=y
CONFIG_TARGET_mvebu_cortexa9_DEVICE_linksys_wrt1900acs=y

#
# LuCI - minimal management
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-system=y
CONFIG_PACKAGE_luci-app-network=y
CONFIG_PACKAGE_luci-app-mountd=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-backup=y
CONFIG_PACKAGE_luci-app-upgrade=y
CONFIG_PACKAGE_luci-app-terminal=y

#
# Chinese
#
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-system-zh-cn=y
CONFIG_PACKAGE_luci-i18n-network-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mountd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-backup-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upgrade-zh-cn=y
CONFIG_PACKAGE_luci-i18n-terminal-zh-cn=y

#
# Basic router functions
# WAN DHCP / LAN DHCP / NAT / firewall
#
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_dnsmasq-full=n
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd-ipv6only=n

#
# Linksys
#
CONFIG_PACKAGE_linksys-reboot=y

#
# WiFi completely disabled
#
CONFIG_PACKAGE_kmod-mwlwifi=n
CONFIG_PACKAGE_mwlwifi-firmware-88w8864=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-basic=n
CONFIG_PACKAGE_wireless-tools=n
CONFIG_PACKAGE_luci-app-wireless=n

#
# IPv6 disabled
#
CONFIG_PACKAGE_ipv6-support=n
CONFIG_PACKAGE_kmod-ipv6=n
CONFIG_PACKAGE_dnsmasq-ipv6=n
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd-ipv6only=n

#
# PPP / PPPoE disabled
#
CONFIG_PACKAGE_ppp=n
CONFIG_PACKAGE_ppp-mod-pppoe=n
CONFIG_PACKAGE_pppoe-discovery=n

#
# USB / U-Disk fallback
#
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_e2fsprogs-mke2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_mountd=y

#
# mDNS / cross-subnet discovery
#
CONFIG_PACKAGE_avahi-daemon=y
CONFIG_PACKAGE_luci-app-avahi=y

#
# Essential network diagnostics
#
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump=y

#
# Super Audio Bridge runtime
# The bridge itself is installed later as IPK
#
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-aiohttp=y
CONFIG_PACKAGE_python3-yaml=y

#
# Proxy / traffic / unrelated services disabled
#
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_xray-core=n
CONFIG_PACKAGE_shadowsocks-libev=n
CONFIG_PACKAGE_mihomo=n
CONFIG_PACKAGE_3proxy=n
CONFIG_PACKAGE_chinadns-ng=n

CONFIG_PACKAGE_nlbwmon=n
CONFIG_PACKAGE_luci-app-nlbwmon=n
CONFIG_PACKAGE_luci-app-qos=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_miniupnpd=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_wol=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_vlmcsd=n
CONFIG_PACKAGE_vsftpd=n
CONFIG_PACKAGE_luci-app-vsftpd=n
CONFIG_PACKAGE_luci-app-statistics=n
CONFIG_PACKAGE_collectd=n
CONFIG_PACKAGE_luci-app-diag-core=n
CONFIG_PACKAGE_luci-mod-status=n
