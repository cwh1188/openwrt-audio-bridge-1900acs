#
# OpenWrt 23.05.6
# Linksys WRT1900ACS v2
# Minimal Wired Audio Bridge Router
#

#
# Target
#

CONFIG_TARGET_mvebu=y
CONFIG_TARGET_mvebu_cortexa9=y
CONFIG_TARGET_mvebu_cortexa9_DEVICE_linksys_wrt1900acs=y

#
# Base system
#

CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubus2023=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uci-lua=y
CONFIG_PACKAGE_libubus-lua=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y

#
# Network core
#

CONFIG_PACKAGE_dnsmasq=y
# CONFIG_PACKAGE_dnsmasq-full is not set
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y

#
# Wired DSA / PHY
# DO NOT REMOVE
#

CONFIG_PACKAGE_kmod-dsa=y
CONFIG_PACKAGE_kmod-dsa-mv88e6xxx=y
CONFIG_PACKAGE_kmod-ptp=y
CONFIG_PACKAGE_kmod-phy-marvell=y
CONFIG_PACKAGE_kmod-libphy=y

#
# Linksys dual-partition reboot
#

CONFIG_PACKAGE_linksys-reboot=y
CONFIG_PACKAGE_luci-app-advanced-reboot=y
CONFIG_PACKAGE_luci-i18n-advanced-reboot-zh-cn=y

#
# LuCI
#

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-status=y

#
# LuCI applications
#

CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-system=y
CONFIG_PACKAGE_luci-app-network=y
CONFIG_PACKAGE_luci-app-mountd=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-backup=y
CONFIG_PACKAGE_luci-app-upgrade=y
CONFIG_PACKAGE_luci-app-ttyd=y

#
# Chinese language
#

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-system-zh-cn=y
CONFIG_PACKAGE_luci-i18n-network-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mountd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-backup-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upgrade-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

#
# USB / U-disk fallback
#

CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_mk2fs=y
CONFIG_PACKAGE_mke2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y

#
# mDNS / Avahi
#

CONFIG_PACKAGE_avahi-daemon=y
CONFIG_PACKAGE_luci-app-avahi=y

#
# Network diagnostics
#

CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump=y

#
# Python runtime for Super Audio Bridge
#

CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-pip=y
CONFIG_PACKAGE_python3-light=y
CONFIG_PACKAGE_python3-aiohttp=y
CONFIG_PACKAGE_python3-yaml=y

#
# Disable WiFi
#

# CONFIG_PACKAGE_kmod-mwlwifi is not set
# CONFIG_PACKAGE_mwlwifi-firmware-88w8864 is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-wolfssl is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
# CONFIG_PACKAGE_wpad-openssl is not set

#
# Disable IPv6
#

# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set

#
# Disable PPP / PPPoE
#

# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_luci-proto-ppp is not set

#
# Disable proxy / PassWall / SSR / Clash / Mihomo
#

# CONFIG_PACKAGE_3proxy is not set
# CONFIG_PACKAGE_chinadns-ng is not set
# CONFIG_PACKAGE_dns2tcp is not set
# CONFIG_PACKAGE_ipt2socks is not set
# CONFIG_PACKAGE_mihomo is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-openclash is not set

#
# Disable traffic statistics / QoS
#

# CONFIG_PACKAGE_nlbwmon is not set
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
# CONFIG_PACKAGE_luci-app-qos is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set

#
# Disable unrelated LuCI applications
#

# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-wol is not set

#
# Keep Status menu
#
# IMPORTANT:
# Do NOT hide or delete luci-mod-status.
# Run #10 intentionally keeps Status exactly as Run #8.
#

CONFIG_PACKAGE_luci-mod-status=y

#
# Kernel / system
#

CONFIG_KERNEL_PRINTK=y
CONFIG_KERNEL_PRINTK_TIME=y

#
# Keep normal filesystem support
#

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
